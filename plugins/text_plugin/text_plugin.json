{
    "name": "text",
    "version": "1.0.0",
    "description": "自定义文本插件，演示跨插件调用",
    "class": "TextPlugin",
    "routes": {
        "GET": [
            {
                "function": "upper",
                "path": "/upper"
            },
            {
                "function": "use_calc",
                "path": "/use-calc"
            }
        ],
        "POST": [
            {
                "function": "repeat",
                "path": "/repeat"
            },
            {
                "function": "process_json",
                "path": "/process-json"
            }
        ]
    }
}
