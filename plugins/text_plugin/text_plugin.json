{
    "name": "text",
    "version": "1.0.0",
    "description": "自定义文本插件，演示跨插件调用",
    "class": "TextPlugin",
    "routes": [
        {
            "function": "upper",
            "method": "GET",
            "path": "/text/upper"
        },
        {
            "function": "repeat",
            "method": "POST",
            "path": "/text/repeat"
        },
        {
            "function": "use_calc",
            "method": "GET",
            "path": "/text/use-calc"
        }
    ]
}
